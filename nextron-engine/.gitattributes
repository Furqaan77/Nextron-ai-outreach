# Vendored static files must stay byte-identical: tests/contracts/test_vendored_assets.py pins
# their SHA-256, so git must never convert their line endings.
nextron/web/static/** -text
nextron/domain/psl/** -text
nextron/domain/geodata/** -text
# Prompt files are hash-locked (nextron/adapters/ai/prompts/manifest.lock). Their hash is taken
# with universal newlines, but keep them byte-identical anyway.
nextron/adapters/ai/prompts/** -text
